{
  "name": "willo",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/ui"
  ],
  "scripts": {
    "start": "bun run --cwd packages/frontend start",
    "web": "bun run --cwd packages/frontend web",
    "android": "bun run --cwd packages/frontend android",
    "ios": "bun run --cwd packages/frontend ios",
    "typecheck": "bun run --cwd packages/ui typecheck && bun run --cwd packages/frontend typecheck && bun run --cwd packages/backend typecheck",
    "lint": "biome check . && bun run --cwd packages/frontend lint",
    "check:bun-pin": "bun test ./tests/bun-pin.test.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "overrides": {
    "lightningcss": "1.30.1",
    "react-native-css": "3.1.0-rc.0",
    "@oxy.so/core": "6.9.1",
    "@oxy.so/contracts": "5.4.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/services": "12.4.0",
    "@oxy.so/bloom": "15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
