{
  "name": "@willo.sh/backend",
  "private": true,
  "type": "commonjs",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f docker-compose.postgres.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.postgres.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "@oxy.so/core": "^1.1.2",
    "@oxy.so/db": "^1.0.0",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "postgres": "3.4.9",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "drizzle-kit": "0.31.10",
    "typescript": "~6.0.3"
  }
}
