# Oxy platform API base URL.
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so

# Willo's backend: the frame's own row (/frames/me), its Home and its devices.
EXPO_PUBLIC_WILLO_API_URL=https://api.willo.sh

# Clarity's API, for the news card (public news, no credential).
EXPO_PUBLIC_CLARITY_API_URL=https://api.clarity.surf

# Willo's registered Oxy client id: a frame signs in AS Willo (it is a Willo
# sub-app), so frame.willo.sh is one of that client's web origins.
EXPO_PUBLIC_OXY_CLIENT_ID=oxy_dk_fb8d8c425643f2bd3983386674e9704d81746295d0a3345b

# Must match a redirect URI registered on that client.
EXPO_PUBLIC_OXY_AUTH_REDIRECT_URI=https://frame.willo.sh

# Oxy Updates release channel the APK polls (under Willo's application).
EXPO_PUBLIC_OXY_UPDATES_CHANNEL=frame-production
