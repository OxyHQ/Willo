# Oxy platform API base URL.
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so

# Willo's own backend — REST + the /homes and /tunnel Socket.IO namespaces.
# The frontend never talks to a Home Assistant instance directly; it always
# goes through this (see providers/willo-tunnel.ts).
EXPO_PUBLIC_WILLO_API_URL=https://api.willo.sh

# Willo's registered Oxy OAuth client id (ApplicationCredential publicKey,
# type 'public'), minted by OxyHQ/oxy's seed-oxy-applications workflow for
# application id b043569d14d358371cb545b5. Required by @oxy.so/services on
# web — without it, OxySignInButton's popup/redirect flow no-ops with
# `missing-client-id` and the app cannot sign anyone in.
EXPO_PUBLIC_OXY_CLIENT_ID=oxy_dk_fb8d8c425643f2bd3983386674e9704d81746295d0a3345b

# Must exactly match a redirect URI registered on the credential above.
EXPO_PUBLIC_OXY_AUTH_REDIRECT_URI=https://willo.sh
