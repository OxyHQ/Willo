{
  "expo": {
    "name": "Willo",
    "slug": "willo",
    "privacy": "public",
    "scheme": "willo",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "description": "Willo — smart home control by Oxy",
    "plugins": [
      "expo-router",
      ["@oxy.so/app-preset", {}]
    ]
  }
}