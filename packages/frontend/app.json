{
  "expo": {
    "name": "Willo",
    "slug": "willo",
    "privacy": "public",
    "scheme": "willo",
    "platforms": ["ios", "android", "web"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "description": "Willo — smart home control by Oxy",
    "plugins": [
      "expo-router",
      ["@oxy.so/app-preset", {}],
      [
        "expo-camera",
        {
          "cameraPermission": "Willo uses the camera to scan the QR code shown on your Home Assistant device when connecting it."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Willo uses the microphone so you can talk to Alia.",
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": ["android.permission.RECORD_AUDIO"]
        }
      ],
      "./plugins/withOxyDebugSigning",
      "@oxy.so/app-preset/plugin/withOxyAndroidRelease"
    ],
    "android": {
      "package": "sh.willo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
